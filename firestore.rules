rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Groups: anyone signed in can read; start one as the first member, or join with a free slot.
    match /groups/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.memberNames.size() == 1
        && request.resource.data.groupSize is int
        && request.resource.data.groupSize >= 2 && request.resource.data.groupSize <= 10
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');

      // Joining may only append yourself, and only while there is room and time left.
      allow update: if signedIn()
        && resource.data.expiresAt > request.time
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.memberUids.size() <= resource.data.groupSize
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberNames.size() == request.resource.data.memberUids.size()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberNames']);
    }

    // Orders: you can create and read only your own, and never change or delete them.
    match /orders/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.paid is number && request.resource.data.paid >= 0;
    }
  }
}
